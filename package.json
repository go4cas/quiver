{
  "name": "quiver-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "recipes",
    "starter",
    "examples/*",
    "docs"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "bun run --filter quiver-starter dev",
    "build": "bun run --filter quiver-starter build",
    "preview": "bun run --filter quiver-starter preview",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run && bun run --filter '*' test",
    "test:watch": "bun run --filter quiver-starter test:watch",
    "test:e2e": "bun run --filter '*' test:e2e",
    "test:browsers": "bun run --filter @go4cas/quiver test:browsers",
    "test:visual": "bun run --filter quiver-starter test:visual",
    "recipes:sync": "node scripts/sync-recipes.js",
    "docs:dev": "bun run --filter quiver-docs dev",
    "docs:build": "bun run --filter quiver-docs build",
    "docs:preview": "bun run --filter quiver-docs preview",
    "pack:check": "vitest run --config tests/pack/vitest.config.js",
    "pack:try": "node scripts/try-packed.js",
    "pack:types": "node scripts/check-packed-types.js",
    "audit": "bun scripts/audit.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "vue": "3.5.45",
    "@vue/compiler-core": "3.5.45",
    "@vue/compiler-dom": "3.5.45",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/compiler-ssr": "3.5.45",
    "@vue/reactivity": "3.5.45",
    "@vue/runtime-core": "3.5.45",
    "@vue/runtime-dom": "3.5.45",
    "@vue/server-renderer": "3.5.45",
    "@vue/shared": "3.5.45",
    "source-map-js": "1.2.2"
  }
}
