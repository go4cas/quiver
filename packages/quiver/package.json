{
  "name": "@go4cas/quiver",
  "version": "3.0.2",
  "description": "A small drop-in router, context and meta layer for Arrow.js apps.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "types": "./types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go4cas/quiver.git",
    "directory": "packages/quiver"
  },
  "exports": {
    ".":      { "types": "./types/index.d.ts",     "default": "./src/index.js" },
    "./vite": { "types": "./types/node/vite.d.ts", "default": "./src/node/vite.js" },
    "./bun":  { "types": "./types/node/bun.d.ts",  "default": "./src/node/bun.js" },
    "./client": { "types": "./client.d.ts" },
    "./package.json": "./package.json"
  },
  "bin": { "quiver": "bin/quiver.js" },
  "files": ["src", "types", "bin", "client.d.ts", "recipes", "AGENTS.md", "llms.txt", "README.md", "LICENSE"],
  "peerDependencies": {
    "@arrow-js/core": "^1.0.6"
  },
  "devDependencies": {
    "@arrow-js/core": "^1.0.6",
    "@types/node": "^22.20.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium-root --project=chromium-subpath",
    "test:browsers": "playwright test",
    "prepack": "node scripts/prepack.js",
    "postpack": "node scripts/postpack.js"
  }
}
